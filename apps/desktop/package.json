{
  "name": "@immortility/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint src && prettier --check src/*.tsx src/command/*.tsx src/face/*.ts src/face/*.tsx src/companion/*.tsx src/state.ts src/transport.ts src/state.test.ts src/style.css",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.170.0",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
