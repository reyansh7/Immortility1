{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immortility.local/schemas/approval.v1.json",
  "title": "Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "task_id",
    "tool_id",
    "action_digest",
    "expires_at",
    "reason",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "action_digest": {
      "type": "string",
      "minLength": 32
    },
    "target_summary": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "cancelled"
      ]
    },
    "granted_scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
