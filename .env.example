# DO NOT PUT REAL SECRETS IN THIS FILE OR COMMIT .env
APP_ENV=development
HOST=127.0.0.1
# Use OS-selected port or server-managed private port with authenticated session.

# Existing free-tier keys, stored server-side only
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Stored in Windows Credential Manager. Not a chat route until a model and a live $0 price are verified.
NVIDIA_API_KEY=

# Model IDs: dynamic free-tier discovery and allowlist validation required.
GROQ_REASONING_MODEL=openai/gpt-oss-120b
OPENROUTER_FREE_MODEL=openrouter/free
GEMINI_CHAT_MODEL=  # Set after checking currently eligible free models in this account

# Paid APIs are disabled by default.
ALLOW_PAID_INFERENCE=false
MONTHLY_PAID_BUDGET_USD=0
XAI_API_KEY= # OPTIONAL, do not populate for free-only mode

# Safe defaults
SCREEN_CAPTURE_ENABLED=false
MICROPHONE_ENABLED=false
WAKE_WORD_ENABLED=false
AUTOMATION_ENABLED=false
REMOTE_CONTROL_ENABLED=false
AUTOSTART_ENABLED=false
TELEMETRY_ENABLED=false
EXPERIMENTAL_QWEN_TTS=false
INFERNAL_VOICE_ENABLED=false
WORKSPACE_ALLOWED_ROOTS=
HERMES_URL= # Local loopback URL, establish authenticated session before use
# P1 uses an isolated owned stdio gateway, not your existing gateway/configuration.
HERMES_SOURCE=C:/Users/reyan/AppData/Local/hermes/hermes-agent
HERMES_REVISION=04b88a4c
# Native shell selects %LOCALAPPDATA%/Immortility automatically.
# DATA_DIR=C:/path/to/private/Immortility
CURSOR_AGENT_PATH= # Absolute path or discovered from PATH
COMFYUI_URL= # Optional loopback-only local instance
